{
  "name": "extension-manager-ui",
  "version": "1.0.485",
  "scripts": {
    "preinstall": "npx only-allow npm",
    "start": "ng serve --serve-path=/ui/marketplace/ui/",
    "build": "ng build",
    "test": "npm run test:unit || true",
    "test:unit": "jest --detectOpenHandles",
    "test:cov": "jest --runInBand --coverage --silent",
    "lint": "ng lint",
    "lint:fix": "ng lint --fix",
    "extract": "ng xi18n --output-path=src/locale --ivy",
    "format": "prettier --write --list-different .",
    "check-format": "prettier --check .",
    "pipeline": "npm run check-format && npm run lint && ACCESS_TOKEN=$PIPER_VAULTCREDENTIAL_ACCESS_TOKEN node node_modules/@openmfp/gha-cache/angular.js",
    "postinstall": "husky install .husky"
  },
  "lint-staged": {
    "*.{ts,css,md,html,json,scss}": "prettier -w",
    "*.ts": "eslint --cache"
  },
  "dependencies": {
    "@angular/animations": "19.2.14",
    "@angular/cdk": "19.2.17",
    "@angular/common": "19.2.14",
    "@angular/compiler": "19.2.14",
    "@angular/core": "19.2.14",
    "@angular/elements": "19.2.14",
    "@angular/forms": "19.2.14",
    "@angular/localize": "19.2.14",
    "@angular/platform-browser": "19.2.14",
    "@angular/platform-browser-dynamic": "19.2.14",
    "@angular/router": "19.2.14",
    "@apollo/client": "^3.13.8",
    "@dxp/ngx-core": "^19.0.24",
    "@fundamental-ngx/cdk": "~0.56.2",
    "@fundamental-ngx/core": "~0.56.2",
    "@fundamental-ngx/datetime-adapter": "~0.56.2",
    "@fundamental-ngx/i18n": "~0.56.2",
    "@fundamental-ngx/platform": "~0.56.2",
    "@fundamental-styles/common-css": "0.30.2",
    "@luigi-project/client": "^2.22.1",
    "@luigi-project/client-support-angular": "^2.22.1",
    "@ngrx/effects": "19.2.0",
    "@ngrx/operators": "^19.2.0",
    "@ngrx/router-store": "19.2.0",
    "@ngrx/store": "19.2.0",
    "@ngrx/store-devtools": "19.2.0",
    "@sap-theming/theming-base-content": "~11.30.0",
    "apollo-angular": "^10.0.3",
    "axios": "^1.10.0",
    "deep-equal": "2.2.3",
    "deepmerge": "4.3.1",
    "fundamental-styles": "0.40.1",
    "graphql": "16.11.0",
    "graphql-sse": "2.5.4",
    "graphql-ws": "5.16.2",
    "jsonschema": "^1.4.1",
    "moment": "2.30.1",
    "rxjs": "7.8.1",
    "ts-md5": "1.3.1",
    "tslib": "2.8.1",
    "url": "^0.11.4",
    "zone.js": "0.15.1"
  },
  "devDependencies": {
    "@angular/build": "^19.2.15",
    "@angular/cli": "19.2.15",
    "@angular/compiler-cli": "19.2.14",
    "@graphql-tools/graphql-file-loader": "^8.1.9",
    "@graphql-tools/load": "^8.1.8",
    "@graphql-tools/merge": "^9.1.7",
    "@graphql-tools/url-loader": "^9.0.6",
    "@luigi-project/testing-utilities": "2.14.1",
    "@openmfp/config-prettier": "^0.9.1",
    "@openmfp/eslint-config-typescript": "^0.7.5",
    "@openmfp/gha-cache": "^0.5.23",
    "@trivago/prettier-plugin-sort-imports": "^5.2.2",
    "@types/jest": "29.5.12",
    "@types/node": "22.15.18",
    "angular-eslint": "^20.5.1",
    "eslint": "^9.29.0",
    "eslint-config-prettier": "^10.0.2",
    "eslint-plugin-jest": "^28.14.0",
    "husky": "9.1.7",
    "jest": "29.7.0",
    "jest-jasmine2": "29.7.0",
    "jest-junit": "16.0.0",
    "jest-mock-extended": "3.0.7",
    "jest-preset-angular": "14.6.0",
    "kubernetes-types": "1.30.0",
    "lint-staged": "15.5.2",
    "ng-lint-staged": "12.0.4",
    "ng-mocks": "14.13.5",
    "prettier": "3.5.3",
    "ts-node": "10.9.2",
    "typescript": "5.8.3",
    "typescript-eslint": "^8.34.1"
  },
  "type": "module"
}
